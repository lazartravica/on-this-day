PORT=8787
MERCHANT_ORIGIN=http://localhost:8787

# Local Curvy devenv (pnpm run dev:quick in curvy-monorepo)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
CONFIRMATIONS=1
# CurvyAggregator proxy: `CurvyAggregator#CurvyAggregatorAlphaV2` in contracts/evm/ignition/deployments/local_anvil/deployed_addresses.json (changes on redeploy)
CURVY_AGGREGATOR=0xc6e7DF5E7b4f2A278906862b61205850344D4e7d
# Devenv EIP3009TokenMock ("USDC", 6 decimals)
PAYMENT_TOKEN=0xa513E6E4b8f2a923D98304ec87F64353C4D5C853
PRICE_PER_LOOKUP_BASE_UNITS=10000
# Human checkout rejects payments under $0.50 (portal broadcaster); one checkout buys this many lookups
LOOKUPS_PER_PURCHASE=100
# Curvy portal broadcaster (pnpm demo:payments, :4035); shields agent payments and reports contract addresses.
# Its PORTAL_MIN_USD_VALUE must be <= the price ($0.01): the demo stack uses 0.001, production defaults to 0.5
CURVY_BROADCASTER_URL=http://127.0.0.1:4035
# Optional: any x402 v2 facilitator (e.g. Coinbase's) to also offer the gasless `exact` scheme
# X402_FACILITATOR_URL=
# Hosted checkout page. NOT documented on docs.curvy.box; set to your environment's value.
CURVY_CHECKOUT_ORIGIN=

# Public receiving keys ("X.Y" decimal point strings) and the request signing key.
# Generate throwaway dev values with: pnpm keys
CURVY_PUBLIC_S=
CURVY_PUBLIC_V=
CURVY_PUBLIC_BABYJUBJUB=
MERCHANT_SIGNER_PRIVATE_KEY=
MERCHANT_SIGNER_NOT_AFTER=2027-01-01T00:00:00.000Z
