PORT=8787
MERCHANT_ORIGIN=http://localhost:8787

# Ethereum Sepolia, served by Curvy's production stack as a testnet (nobody pays real money).
# Values from GET https://api.curvy.box/portal/networks/11155111
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONFIRMATIONS=2
CURVY_AGGREGATOR=0x5d4a04d6c9bdf4613e7acd92e570539a5a6dba84
# Circle's Sepolia USDC (6 decimals, EIP-3009), vault token id 2. Faucet: https://faucet.circle.com/
PAYMENT_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Curvy's portal broadcaster fails portals under $0.50 after the payer has paid, so a lookup costs $0.50 here
PRICE_PER_LOOKUP_BASE_UNITS=500000
LOOKUPS_PER_PURCHASE=1
# Curvy portal broadcaster and x402 facilitator: unset = the SDK's defaults, https://api.curvy.box and
# https://api.curvy.box/portal/x402. Set X402_FACILITATOR_URL to another x402 v2 facilitator, or to `none`
# to offer curvy-transfer only.
# CURVY_BROADCASTER_URL=
# X402_FACILITATOR_URL=
# Hosted checkout page for the human rail; Curvy provides it at onboarding (hey@curvy.box).
CURVY_CHECKOUT_ORIGIN=

# Public receiving keys ("X.Y" decimal point strings) and the request signing key.
# Generate throwaway dev values with: pnpm keys
CURVY_PUBLIC_S=
CURVY_PUBLIC_V=
CURVY_PUBLIC_BABYJUBJUB=
MERCHANT_SIGNER_PRIVATE_KEY=
MERCHANT_SIGNER_NOT_AFTER=2027-01-01T00:00:00.000Z
