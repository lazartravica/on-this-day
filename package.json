{
  "name": "on-this-day",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "keys": "tsx src/scripts/gen-signer.ts",
    "test:e2e": "tsx --env-file-if-exists=.env test/e2e-local.ts",
    "test:checkout-side": "tsx --env-file-if-exists=.env test/checkout-side.ts",
    "test:x402": "tsx --env-file-if-exists=.env test/x402-agent.ts",
    "agent": "tsx examples/agent.ts",
    "agent:raw": "tsx examples/agent-raw.ts"
  },
  "dependencies": {
    "@0xcurvy/payments-sdk": "0.1.2",
    "@0xcurvy/rs-core-wasm": "0.1.0-rc.4",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
